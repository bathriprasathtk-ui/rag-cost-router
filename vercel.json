{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "env": {
    "VECTOR_STORE": "memory",
    "EMBEDDING_PROVIDER": "hashing",
    "METRICS_PATH": "/tmp/requests.jsonl",
    "ALLOW_PATH_INGEST": "false"
  }
}
