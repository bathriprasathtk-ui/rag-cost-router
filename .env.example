# ---- LLM provider ----------------------------------------------------------
# auto (default): GROQ_API_KEY -> Groq, else OPENAI_API_KEY -> OpenAI, else offline mock.
# Force one with: LLM_PROVIDER=groq | openai | mock

# Free tier (recommended): get a key at https://console.groq.com/keys (no card).
GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# SMALL_MODEL=openai/gpt-oss-20b
# LARGE_MODEL=openai/gpt-oss-120b

# Or OpenAI:
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Embeddings: sentence-transformers (local) | openai | hashing ---------
# EMBEDDING_PROVIDER=sentence-transformers
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---- Vector store ----------------------------------------------------------
# auto (default): Qdrant when reachable at QDRANT_URL, else in-memory.
# Start Qdrant with: docker compose up -d qdrant
# VECTOR_STORE=qdrant
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_COLLECTION=rag_chunks
# QDRANT_API_KEY=

# ---- Routing ----
# Difficulty score (0..1) at or above which queries route to the large model.
# ROUTE_THRESHOLD=0.55
# Escalate to the large model if the small model answer looks like a refusal.
# ESCALATE_ON_LOW_CONFIDENCE=true
# Optional daily budget: once spent, all requests downshift to the small model.
# BUDGET_USD_PER_DAY=5.0

# ---- Semantic cache ----
# Minimum cosine similarity for a cache hit.
# CACHE_THRESHOLD=0.94
# CACHE_TTL_SECONDS=86400
# CACHE_MAX_ENTRIES=2000

# ---- App ----
# HOST=127.0.0.1
# PORT=8000
# DB_PATH=data/metrics.db
# DOCS_DIR=sample_data
